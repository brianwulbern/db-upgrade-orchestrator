# Sample catalog for the demo. Fake customers only, no real data.
# Columns: engine | dump | target_db | modl | offset | heap(MB) | es_mode | flags
# offset/es_mode/flags are notes only; the scheduler assigns its own slot and always uses remote ES.
mysql     | customer-a.sql          | customer_a          | customer-a          | 1 | 4096 | remote | -
postgres  | customer-b.sql          | customer_b          | customer-b          | 2 | 4096 | remote | -
sqlserver | customer-c.bak.7z       | customer-c          | customer-c          | 3 | 6144 | remote | -
oracle    | customer-d.dmp          | customer_d          | customer-d          | 4 | 8192 | remote | -
mysql     | customer-e.sql          | customer_e          | customer-e          | 5 | 4096 | remote | -
postgres  | customer-f.sql          | customer_f          | customer-f          | 6 | 4096 | remote | -
mysql     | customer-fail-once.sql  | customer_fail_once  | customer-fail-once  | 7 | 4096 | remote | -
postgres  | customer-g.sql          | customer_g          | customer-g          | 8 | 6144 | remote | -
